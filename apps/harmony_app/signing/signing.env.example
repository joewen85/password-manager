# Copy this file to signing.env and fill with real values.
# Example:
#   cp apps/harmony_app/signing/signing.env.example apps/harmony_app/signing/signing.env

HARMONY_SIGN_STORE_FILE=/absolute/path/to/your_store.p12
HARMONY_SIGN_STORE_PASSWORD=change_me
HARMONY_SIGN_KEY_ALIAS=your_key_alias
HARMONY_SIGN_KEY_PASSWORD=change_me
HARMONY_SIGN_PROFILE=/absolute/path/to/your_profile.p7b
HARMONY_SIGN_CERTPATH=/absolute/path/to/your_cert.cer
