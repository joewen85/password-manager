export function resolveAppLanguage(
  preference: AppLanguagePreference,
  systemLanguageCode: string,
): 'en' | 'zh' {
  if (preference === 'english') {
    return 'en';
  }
  if (preference === 'simplifiedChinese') {
    return 'zh';
  }
  return systemLanguageCode.toLowerCase().startsWith('zh') ? 'zh' : 'en';
}

export function localizeText(value: string, language: string): string {
  if (language !== 'en') {
    return value;
  }
  return ENGLISH_STRINGS.get(value) ?? value;
}

export function formatLocalizedText(template: string, language: string, values: string[]): string {
  let result = localizeText(template, language);
  values.forEach((value: string, index: number) => {
    result = result.replace('{' + index + '}', value);
  });
  return result;
}
